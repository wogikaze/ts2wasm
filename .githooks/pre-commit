#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: issues/index.md (regen if needed)"
if ! scripts/update_issue_index.sh --check; then
  scripts/update_issue_index.sh
  git add issues/index.md
fi

echo "pre-commit: issues/ mechanical checks (scripts/check_issue_queue.sh)"
scripts/check_issue_queue.sh

md_files="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)"

if [ -n "$md_files" ]; then
  echo "pre-commit: markdownlint modified staged markdown files"
  printf '%s\n' "$md_files" | xargs npx markdownlint-cli2 --fix
  printf '%s\n' "$md_files" | xargs git add
fi