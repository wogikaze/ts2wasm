#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"

if printf '%s\n' "$staged_files" | grep -Eq '(^|/)(Cargo\.toml|Cargo\.lock|.*\.rs)$'; then
  echo "pre-commit: cargo fmt --all --check"
  cargo fmt --all --check
  echo "pre-commit: cargo clippy --all-targets -- -D warnings"
  cargo clippy --all-targets -- -D warnings
else
  echo "pre-commit: skip cargo fmt and clippy; no staged Rust changes"
fi

if printf '%s\n' "$staged_files" | grep -Eq '^(issues/|scripts/gen/update-issue-index\.py|scripts/check/issue-health\.py)'; then
  echo "pre-commit: issues/ mechanical checks"
  python3 scripts/check/issue-health.py
else
  echo "pre-commit: skip issues check; no staged issues/scripts changes"
fi

md_files="$(printf '%s\n' "$staged_files" | grep -E '\.md$' || true)"

if [ -n "$md_files" ]; then
  echo "pre-commit: markdownlint modified staged markdown files"
  printf '%s\n' "$md_files" | xargs npx --no-install markdownlint-cli2 --fix
  printf '%s\n' "$md_files" | xargs git add
else
  echo "pre-commit: skip markdownlint; no staged markdown files"
fi