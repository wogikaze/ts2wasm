#!/usr/bin/env bash
# Single entry to repo scripts. Prefer this or `mise run <task>` (see root mise.toml)
# so you do not need to open each scripts/*.sh to see flags.
#
# Usage (from repository root):
#   scripts/manager
#   scripts/manager help
#   scripts/manager <command> [args to underlying script...]
set -euo pipefail

repo_root="$(cd "$(dirname "${0}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'MSG'
ts2wasm — script manager (one entry; arguments pass through to the underlying .sh)

Usage:
  scripts/manager [help]
  scripts/manager <command> [args...]

Examples:
  scripts/manager check-issue-queue
  scripts/manager update-issue-index -- --check
  scripts/manager nextest -- --no-fail-fast
  ./scripts/run/test262.sh --sample 5 2>&1 | scripts/manager test-differential-reporter

Commands:
MSG
  # column(1) may be missing on minimal systems
  if command -v column &>/dev/null; then
    column -s $'\t' -t <<'TABLE'
check-scripts	Bash -n on scripts/*.sh (syntax)
check-fast-gate	fmt + scripts + issues + coverage matrix + nextest (see script --help)
check-manifest-imports	Manifest JSON imports vs wasm import section (needs wasm-tools, jq)
check-test-records-schema	Validate TestRecord JSONL lines (stdin or file)
check-fixture-catalog	Fixtures/ top-level layout rules (kebab-case dirs only)
check-architecture-rules	Lightweight crate boundary checks (cargo tree)
check-compiler-diagnostics	No panic! in backend/runtime/main.rs
check-harness-installation	Full harness baseline: P0 tools + nextest + all project gates
check-toolchain	Verify rust/node/iwasm/wasm-tools/ast-grep and search tools exist
check-fixture-differential	Node vs iwasm: runs nextest m2_node_diff
check-host-deny	Standalone fixtures must not emit wasm (import "host" ...)
check-runtimefn-invariants	Unit tests: runtime_link_plan + runtime_fn invariants
check-wasm-validation	Build sample fixtures; wasm-tools validate
check-issue-index	Fail if issues/index.md is stale or queue tables are wrong
check-issue-queue	Mechanical invariants: ids, done checkboxes, paths, index+tables
update-issue-index	Regenerate index tables (add -- --check to verify only)
install-hooks	Install .githooks (fmt, markdown, issues) via git config core.hooksPath
check-coverage-gate	Compare two coverage matrix docs (args: see script --help)
update-coverage-matrix	Refresh reference coverage table (args: see script --help)
reference-coverage	Run reference test suite for coverage (args: see script --help)
coverage-report	Generate language coverage report from language-reference (args: --format text|markdown)
benchmark-tracker	Append build/fixture performance metrics to JSON
test262	Run test262 harness (stdout JSONL; args: see script --help)
test-differential-reporter	HTML/Markdown report from test262 JSONL (stdin; args optional)
test-regression-gate	Gate: regressions in JSONL vs baseline
fmt	cargo fmt --all --check
clippy	cargo clippy --all-targets
nextest	cargo nextest run
check-repo-smoke	cargo fmt + check-scripts + check-issue-queue (no cargo test)
TABLE
  else
    cat <<'FALL'
  check-scripts              Bash -n on scripts/*.sh (syntax)
  check-fast-gate            fmt + scripts + issues + coverage matrix + nextest
  check-manifest-imports     manifest vs wasm imports (wasm-tools + jq)
  check-test-records-schema  TestRecord JSONL schema gate
  check-fixture-catalog      fixtures/ top-level layout rules
  check-architecture-rules   crate boundary (shared must not depend on cli)
  check-compiler-diagnostics no panic! in backend/runtime/main
  check-harness-installation  full P0+ gates baseline
  check-toolchain             required CLI tools
  check-fixture-differential  m2 node/wasm diff (nextest)
  check-host-deny             no (import "host") in standalone fixtures
  check-runtimefn-invariants    runtime link plan unit tests
  check-wasm-validation         wasm-tools validate on samples
  check-issue-index         Fail if issues/index.md is stale or queue tables are wrong
  check-issue-queue         Mechanical invariants: ids, paths, index+tables
  update-issue-index        Regenerate index tables (add -- --check to verify only)
  install-hooks             Install .githooks via git config core.hooksPath
  check-coverage-gate        Compare two coverage matrix docs
  update-coverage-matrix     Refresh reference coverage table
  reference-coverage         Reference suite coverage runner
  coverage-report            Language coverage report from language-reference
  benchmark-tracker          Performance metrics JSON
  test262                    test262 JSONL to stdout
  test-differential-reporter Report from test262 JSONL (stdin)
  test-regression-gate       JSONL vs baseline
  fmt                        cargo fmt --all --check
  clippy                     cargo clippy --all-targets
  nextest                    cargo nextest run
  check-repo-smoke         cargo fmt + check-scripts + check-issue-queue
FALL
  fi
  echo
  echo "Mise: run \`mise tasks\` / \`mise run <task>\` for the same set (mise optional)."
  echo "Shell scripts: scripts/{check,gate,gen,run,...}/*.sh and scripts/*.sh; this dispatches to them."
}

target="${1:-help}"
if [[ "$target" == "help" || "$target" == "-h" || "$target" == "--help" ]]; then
  usage
  exit 0
fi
shift

case "$target" in
  check-scripts) exec bash "${repo_root}/scripts/check/shell-syntax.sh" "$@" ;;
  check-fast-gate) exec bash "${repo_root}/scripts/gate/fast-gate.sh" "$@" ;;
  check-manifest-imports) exec bash "${repo_root}/scripts/check/manifest-imports.sh" "$@" ;;
  check-test-records-schema) exec bash "${repo_root}/scripts/check/test-records-schema.sh" "$@" ;;
  check-fixture-catalog) exec bash "${repo_root}/scripts/check/fixture-catalog.sh" "$@" ;;
  check-architecture-rules) exec bash "${repo_root}/scripts/check/architecture-rules.sh" "$@" ;;
  check-compiler-diagnostics) exec bash "${repo_root}/scripts/check/compiler-diagnostics.sh" "$@" ;;
  check-harness-installation) exec bash "${repo_root}/scripts/check/harness-installation.sh" "$@" ;;
  check-toolchain) exec bash "${repo_root}/scripts/check/toolchain.sh" "$@" ;;
  check-fixture-differential) exec bash "${repo_root}/scripts/check/fixture-differential.sh" "$@" ;;
  check-host-deny) exec bash "${repo_root}/scripts/check/host-deny.sh" "$@" ;;
  check-runtimefn-invariants) exec bash "${repo_root}/scripts/check/runtimefn-invariants.sh" "$@" ;;
  check-wasm-validation) exec bash "${repo_root}/scripts/check/wasm-validation.sh" "$@" ;;
  check-issue-index) exec python3 "${repo_root}/scripts/check/issue-queue.py" "$@" ;;
  check-issue-queue) exec python3 "${repo_root}/scripts/check/issue-queue.py" "$@" ;;
  update-issue-index) exec bash "${repo_root}/scripts/gen/update-issue-index.sh" "$@" ;;
  install-hooks) exec bash "${repo_root}/scripts/dev/install-git-hooks.sh" "$@" ;;
  check-coverage-gate) exec bash "${repo_root}/scripts/gate/coverage.sh" "$@" ;;
  update-coverage-matrix) exec python3 "${repo_root}/scripts/gen/coverage-matrix.py" "$@" ;;
  reference-coverage) exec bash "${repo_root}/scripts/run/reference-coverage.sh" "$@" ;;
  benchmark-tracker) exec bash "${repo_root}/scripts/perf/benchmark-tracker.sh" "$@" ;;
  test262) exec bash "${repo_root}/scripts/run/test262.sh" "$@" ;;
  test-differential-reporter) exec bash "${repo_root}/scripts/report/differential.sh" "$@" ;;
  test-regression-gate) exec bash "${repo_root}/scripts/gate/regression.sh" "$@" ;;
  fmt) exec cargo fmt --all --check ;;
  clippy) exec cargo clippy --all-targets -- "$@" ;;
  nextest) exec cargo nextest run "$@" ;;
  check-repo-smoke)
    cargo fmt --all --check
    bash "${repo_root}/scripts/check/shell-syntax.sh"
    python3 "${repo_root}/scripts/check/issue-queue.py"
    ;;
  *)
    echo "Unknown command: $target" >&2
    echo "Run: scripts/manager help" >&2
    exit 1
    ;;
esac
