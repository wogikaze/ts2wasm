{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts2wasm.local/schemas/current_task.json",
  "title": "current_task",
  "type": "object",
  "required": [
    "id",
    "title",
    "status"
  ],
  "properties": {
    "id": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "backlog",
        "selected",
        "in_progress",
        "blocked",
        "verifying",
        "done",
        "split"
      ]
    },
    "scope": {
      "type": ["object", "null"],
      "required": ["allowed_files", "forbidden_files"],
      "properties": {
        "allowed_files": { "type": "array", "items": { "type": "string" } },
        "forbidden_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "acceptance": { "type": ["array", "null"], "items": { "type": "string" } },
    "commands": {
      "type": ["object", "null"],
      "required": ["fast", "full"],
      "properties": {
        "fast": { "type": "array", "items": { "type": "string" } },
        "full": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "risk": { "type": ["array", "null"], "items": { "type": "string" } },
    "issue_path": { "type": ["string", "null"], "description": "Optional path to issues/open or issues/done file" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
