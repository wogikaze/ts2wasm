{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts2wasm.local/schemas/test_report.json",
  "title": "test_report",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "git",
    "commands",
    "fixtures",
    "regressions",
    "perf"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "git": {
      "type": "object",
      "required": ["sha", "exit_code", "changed_files", "commits"],
      "properties": {
        "sha": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sha", "message"],
            "properties": {
              "sha": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "status", "exit_code"],
        "properties": {
          "cmd": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip", "error"] },
          "exit_code": { "type": "integer" },
          "elapsed_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "fixtures": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped",
        "newly_passed",
        "newly_failed"
      ],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "newly_passed": { "type": "array", "items": { "type": "string" } },
        "newly_failed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "regressions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "perf": {
      "type": "object",
      "required": ["compile_time_delta_percent", "runtime_delta_percent"],
      "properties": {
        "compile_time_delta_percent": { "type": "number" },
        "runtime_delta_percent": { "type": "number" }
      },
      "additionalProperties": true
    },
    "meta": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
